---
// Learn → connect → grow: each benefit stands on a taller arrow than the one
// before, the three rising arrows of the GHL logo (yellow, blue, green).
import RisingArrow from "./RisingArrow.astro";
---

<section
  class="community-overview"
  id="community"
  aria-labelledby="community-heading"
>
  <div class="wrap">
    <div class="overview-intro">
      <div class="overview-heading reveal">
        <span class="kicker">Community</span>
        <h2 id="community-heading">
          You don’t have to <em>figure it out alone.</em>
        </h2>
      </div>
      <div class="overview-copy reveal">
        <p class="overview-lead">
          The best next step is often a conversation with someone who gets it.
        </p>
        <p class="overview-description">
          We’re a community of people in Bangladesh building with HighLevel. We
          come together to exchange ideas, share practical knowledge, and turn
          online connections into real conversations.
        </p>
      </div>
    </div>

    <div class="overview-benefits reveal" id="benefits">
      <article class="overview-benefit">
        <span class="benefit-eyebrow">01 / Learn</span>
        <h3>Real questions. Practical answers.</h3>
        <p>
          Explore real use cases, ask the questions on your mind, and learn from
          people working with the same tools.
        </p>
        <span class="rise" aria-hidden="true">
          <RisingArrow id="benefit-learn-up" height={170} />
          <RisingArrow
            id="benefit-learn-right"
            height={170}
            direction="right"
          />
        </span>
      </article>
      <article class="overview-benefit">
        <span class="benefit-eyebrow">02 / Connect</span>
        <h3>Meet peers. Find your people.</h3>
        <p>
          Swap stories with local agency owners, marketers, and builders. Make
          connections that go beyond a comment thread.
        </p>
        <span class="rise" aria-hidden="true">
          <RisingArrow id="benefit-connect-up" height={320} />
          <RisingArrow
            id="benefit-connect-right"
            height={320}
            direction="right"
          />
        </span>
      </article>
      <article class="overview-benefit">
        <span class="benefit-eyebrow">03 / Grow</span>
        <h3>New perspectives. Bigger possibilities.</h3>
        <p>
          Build confidence, sharpen your skills, and find fresh approaches to
          the challenges in your business.
        </p>
        <span class="rise" aria-hidden="true">
          <RisingArrow id="benefit-grow-up" height={470} />
          <RisingArrow id="benefit-grow-right" height={470} direction="right" />
        </span>
      </article>
    </div>
  </div>
</section>

<style>
  .community-overview {
    padding: clamp(80px, 11vw, 150px) 0;
  }
  .overview-intro {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
  }
  .overview-heading h2 {
    font-size: clamp(38px, 5vw, 72px);
    line-height: 1.04;
    margin-top: 18px;
  }
  .overview-heading h2 em {
    font-style: normal;
    color: var(--forest);
  }
  .overview-lead {
    margin: 0 0 14px;
    font-family: var(--display);
    font-size: clamp(19px, 1.7vw, 23px);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }
  .overview-description {
    margin: 0;
    color: var(--ink-2);
  }
  .overview-benefits {
    margin-top: clamp(64px, 8vw, 120px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 4vw, 64px);
    align-items: end;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    position: relative;
  }
  .overview-benefit {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .benefit-eyebrow {
    display: block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 12px;
  }
  .overview-benefit h3 {
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.1;
    margin-bottom: 12px;
  }
  .overview-benefit p {
    margin: 0;
    color: var(--ink-2);
    font-size: 15.5px;
    max-width: 330px;
  }
  .rise {
    display: block;
    margin-top: 32px;
    width: clamp(64px, 7vw, 96px);
    color: var(--accent);
    transform-origin: bottom;
    transition: transform 1.1s var(--ease);
  }
  .rise :global(.rising-arrow-right) {
    display: none;
  }
  .overview-benefit:nth-child(1) {
    --accent: var(--yellow);
    --accent-ink: #b08f00;
  }
  .overview-benefit:nth-child(2) {
    --accent: var(--blue);
    --accent-ink: var(--blue);
  }
  .overview-benefit:nth-child(3) {
    --accent: var(--green);
    --accent-ink: #07a944;
  }
  :global(.js) .overview-benefits .rise {
    transform: scaleY(0);
  }
  :global(.js) .overview-benefits:global(.in) .rise {
    transform: none;
  }
  :global(.js)
    .overview-benefits:global(.in)
    .overview-benefit:nth-child(2)
    .rise {
    transition-delay: 0.15s;
  }
  :global(.js)
    .overview-benefits:global(.in)
    .overview-benefit:nth-child(3)
    .rise {
    transition-delay: 0.3s;
  }
  /* dark theme (device setting or the header switch) */
  :global(:root[data-theme="dark"]) .overview-benefit:nth-child(1) {
    --accent-ink: var(--yellow);
  }
  :global(:root[data-theme="dark"]) .overview-benefit:nth-child(3) {
    --accent-ink: var(--green);
  }
  @media (max-width: 960px) {
    .overview-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
  /* on phones the arrows lie down and point at the text */
  @media (max-width: 760px) {
    .overview-benefits {
      grid-template-columns: 1fr;
      gap: 0;
      border-bottom: 0;
      border-left: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
      padding-left: 0;
    }
    .overview-benefit {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto auto;
      column-gap: 20px;
      padding: 22px 0;
    }
    .rise {
      grid-column: 1;
      grid-row: 1/4;
      margin: 0;
      width: var(--h);
      align-self: center;
      transform-origin: left;
    }
    .rise :global(.rising-arrow-up) {
      display: none;
    }
    .rise :global(.rising-arrow-right) {
      display: block;
    }
    .overview-benefit:nth-child(1) {
      --h: 44px;
    }
    .overview-benefit:nth-child(2) {
      --h: 68px;
    }
    .overview-benefit:nth-child(3) {
      --h: 92px;
    }
    .benefit-eyebrow,
    .overview-benefit h3,
    .overview-benefit p {
      grid-column: 2;
    }
    :global(.js) .overview-benefits .rise {
      transform: scaleX(0);
    }
    :global(.js) .overview-benefits:global(.in) .rise {
      transform: none;
    }
  }
</style>
