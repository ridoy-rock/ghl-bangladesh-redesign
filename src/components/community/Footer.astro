---
import { groupUrl } from "../../data/community";
---

<footer class="chapter-footer">
  <div class="wrap">
    <div class="footer-columns">
      <div class="footer-identity">
        <a href="/" class="footer-brand" aria-label="GHL Bangladesh home"
          ><img
            class="logo-dark"
            src="/images/community/chapter-logo-dark.svg"
            width="1430"
            height="266"
            alt="GHL Bangladesh"
            loading="lazy"
          /><img
            class="logo-light"
            src="/images/community/chapter-logo.svg"
            width="1430"
            height="266"
            alt="GHL Bangladesh"
            loading="lazy"
          /></a
        >
      </div>
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col">
          <span class="footer-label">Find your way</span>
          <ul>
            <li><a href="/#community">Community</a></li>
            <li><a href="/members">Members</a></li>
            <li><a href="/events">Events</a></li>
            <li><a href="/resources">Resources</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <span class="footer-label">Let’s connect</span>
          <ul>
            <li>
              <a href={groupUrl} target="_blank" rel="noopener noreferrer"
                >Facebook community <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"><path d="M5 19 19 5M7 5h12v12"></path></svg
                ></a
              >
            </li>
            <li><a href="/volunteers">Volunteers</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-legal">
      <span>© {new Date().getFullYear()} GHL Bangladesh</span>
      <span class="footer-signoff"
        >Made for the people building what’s next.</span
      >
      <nav aria-label="Legal links">
        <a href="/privacy-policy">Privacy</a><a href="/terms-and-conditions"
          >Terms</a
        >
      </nav>
    </div>
  </div>
</footer>

<style>
  .chapter-footer {
    border-top: 1px solid var(--line);
    padding: 64px 0 28px;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }
  .footer-brand img {
    height: 40px;
    width: auto;
  }
  /* dark logo on the light theme, light logo on the dark theme */
  .footer-brand .logo-light {
    display: none;
  }
  :global(:root[data-theme="dark"]) .footer-brand .logo-dark {
    display: none;
  }
  :global(:root[data-theme="dark"]) .footer-brand .logo-light {
    display: block;
  }
  .footer-nav {
    display: contents;
  }
  .footer-label {
    display: block;
    margin: 0 0 16px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .footer-col a {
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .footer-col a:hover {
    color: var(--forest);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-legal {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 14px;
    color: var(--ink-3);
  }
  .footer-legal nav {
    display: flex;
    gap: 20px;
  }
  .footer-legal a {
    text-decoration: none;
  }
  .footer-legal a:hover {
    color: var(--ink);
  }
  @media (max-width: 760px) {
    .footer-columns {
      grid-template-columns: 1fr 1fr;
    }
    .footer-identity {
      grid-column: 1/-1;
    }
  }
</style>
