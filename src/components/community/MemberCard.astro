---
import Photo from "./Photo.astro";
import type { Member } from "../../data/community";

interface Props {
  member: Member;
  accent?: "green" | "blue" | "yellow";
}

const { member, accent = "green" } = Astro.props;
const { name, role, about, photo, alt = "", focus, sample, links } = member;
const articleId = `member-card-${member.slug}`;
const headingId = `member-${member.slug}`;
const sampleLabelId = `member-sample-${member.slug}`;
---

<article
  id={articleId}
  class:list={["member-card", { "is-sample": sample }]}
  aria-labelledby={headingId}
  aria-describedby={sample ? sampleLabelId : undefined}
  data-accent={accent}
>
  <div class="member-media">
    {
      photo && !sample ? (
        <div
          class="member-photo"
          style={focus ? `--focus: ${focus}` : undefined}
        >
          <Photo
            name={photo}
            alt={alt}
            sizes="(max-width: 599px) calc(50vw - 24px), (max-width: 999px) 44vw, (max-width: 1179px) 30vw, 280px"
          />
        </div>
      ) : (
        <div class="member-photo member-placeholder">
          <svg viewBox="0 0 200 250" aria-hidden="true">
            <circle cx="100" cy="95" r="40" />
            <path d="M22 250c0-58 34-96 78-96s78 38 78 96" />
          </svg>
          {sample && (
            <span class="member-sample" id={sampleLabelId}>
              Sample
            </span>
          )}
        </div>
      )
    }
    <span class="member-role">
      <span class="member-dot" aria-hidden="true"></span>{role}
    </span>
  </div>
  <div class="member-body">
    <h3 class="member-name" id={headingId}>{name}</h3>
    <p class="member-about">{about}</p>
    {
      links.length > 0 && (
        <div
          class="member-links"
          role="group"
          aria-label={`${name} profile links`}
        >
          {links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${name} — ${link.label} (opens in a new tab)`}
            >
              {link.label}
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .member-card {
    --accent: var(--green);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 8px;
    border-radius: calc(var(--radius) + 8px);
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -60px rgba(6, 29, 48, 0.45);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }
  .member-card[data-accent="blue"] {
    --accent: var(--blue);
  }
  .member-card[data-accent="yellow"] {
    --accent: var(--yellow);
  }
  .member-media {
    position: relative;
  }
  .member-photo {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--navy-2);
  }
  .member-placeholder {
    background: color-mix(in srgb, var(--accent) 14%, var(--paper-2));
  }
  .member-placeholder svg {
    position: absolute;
    inset: 12% 0 0;
    width: 100%;
    height: 88%;
    fill: color-mix(in srgb, var(--accent) 38%, transparent);
  }
  .member-placeholder::after {
    display: none;
  }
  .member-sample {
    position: absolute;
    z-index: 1;
    top: 12px;
    left: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px dashed color-mix(in srgb, var(--ink) 40%, transparent);
    background: var(--card);
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: none;
  }
  .member-card.is-sample {
    border-style: dashed;
    box-shadow: none;
  }
  .member-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, center);
    transition: transform 0.8s var(--ease);
  }
  .member-photo::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    background: linear-gradient(180deg, transparent, rgba(6, 29, 48, 0.42));
    pointer-events: none;
  }
  .member-role {
    position: absolute;
    z-index: 1;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    max-width: calc(100% - 24px);
    padding: 7px 14px 8px 12px;
    border-radius: 999px;
    background: rgba(6, 29, 48, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }
  .member-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .member-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(18px, 1.8vw, 24px) clamp(14px, 1.5vw, 20px)
      clamp(12px, 1.2vw, 16px);
  }
  .member-name {
    font-family: var(--display);
    font-size: clamp(24px, 2.1vw, 30px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .member-about {
    margin: 10px 0 0;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.6;
  }
  .member-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: auto;
    padding-top: 14px;
  }
  .member-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .member-links a:hover {
    color: var(--forest);
  }
  .member-links a:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 4px;
    border-radius: 3px;
  }
  @media (hover: hover) {
    .member-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 50px 90px -55px rgba(6, 29, 48, 0.55);
    }
    .member-card:hover .member-photo :global(img) {
      transform: scale(1.04);
    }
  }
  @media (max-width: 600px) {
    .member-card {
      padding: 5px;
      border-radius: calc(var(--radius) + 2px);
    }
    .member-photo {
      border-radius: calc(var(--radius) - 4px);
    }
    .member-role {
      left: 7px;
      bottom: 7px;
      max-width: calc(100% - 14px);
      gap: 6px;
      padding: 4px 9px 5px 8px;
      font-size: 13px;
    }
    .member-dot {
      width: 6px;
      height: 6px;
    }
    .member-sample {
      top: 7px;
      left: 7px;
      padding: 3px 7px;
      font-size: 11px;
    }
    .member-body {
      padding: 12px 8px 8px;
    }
    .member-name {
      font-size: 18px;
    }
    .member-about {
      margin-top: 6px;
      font-size: 15px;
      line-height: 1.6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .member-card,
    .member-photo :global(img) {
      transition: none;
    }
  }
</style>
