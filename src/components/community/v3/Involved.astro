---
import Pill from "./Pill.astro";
import Spot from "./Spot.astro";
import { groupUrl, resources } from "../../../data/community";
// Two ways to get involved beyond the meetups: volunteering (opening very
// soon) and a short list of HighLevel resources.
const labels: Record<string, string> = {
  "GET UNSTUCK": "Get unstuck",
  "EXPLORE THE PLATFORM": "Explore the platform",
  "BUILD YOUR SKILLS": "Build your skills",
  "STAY IN THE LOOP": "Stay in the loop",
};
---

<section class="v3-section involved" aria-label="Get involved">
  <div class="v3-wrap involved-grid">
    <article
      class="card volunteer v3-reveal"
      id="volunteer"
      aria-labelledby="volunteer-heading"
    >
      <Spot name="volunteer" class="volunteer-art" />
      <span class="status"
        ><span class="status-dot" aria-hidden="true"></span>Volunteers</span
      >
      <h2 id="volunteer-heading">Volunteer with us.</h2>
      <p class="volunteer-lead">
        We’ll open volunteer opportunities very soon.
      </p>
      <p class="volunteer-text">
        We’ll share the available roles and how to get involved when
        opportunities open.
      </p>
      <div class="volunteer-actions">
        <Pill label="Get community updates" href={groupUrl} />
        <a class="text-link" href="/v3/volunteers">Volunteers page</a>
      </div>
    </article>

    <article
      class="card resources v3-reveal"
      id="resources"
      aria-labelledby="resources-heading"
    >
      <span class="v3-kicker" style="--k: var(--blue)">Keep learning</span>
      <h2 id="resources-heading">A few good places to start.</h2>
      <p class="resources-text">
        Useful HighLevel resources. All in one place.
      </p>
      <ul class="resource-list" role="list">
        {
          resources.map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener noreferrer">
                <span class="resource-number">{r.number}</span>
                <span class="resource-copy">
                  <span class="resource-type">{labels[r.type] ?? r.type}</span>
                  <strong>{r.title}</strong>
                  <span class="resource-desc">{r.description}</span>
                </span>
                <svg
                  class="resource-arrow"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </div>
</section>

<style>
  .involved {
    padding-top: 0;
  }
  .involved-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 16px;
  }
  .card {
    padding: clamp(24px, 4vw, 48px);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
  }
  .volunteer h2,
  .volunteer-lead {
    max-width: calc(100% - 130px);
  }
  h2 {
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  /* Volunteer */
  .volunteer {
    position: relative;
    display: flex;
    flex-direction: column;
    background:
      repeating-linear-gradient(
        -45deg,
        rgba(248, 211, 37, 0.035) 0 10px,
        transparent 10px 20px
      ),
      var(--surface);
  }
  .volunteer :global(.volunteer-art) {
    position: absolute;
    top: clamp(20px, 3vw, 36px);
    right: clamp(16px, 3vw, 36px);
    width: clamp(110px, 12vw, 150px);
  }
  .status {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    padding: 5px 12px 5px 10px;
    border: 1px solid rgba(248, 211, 37, 0.35);
    border-radius: 999px;
    background: rgba(248, 211, 37, 0.08);
    color: color-mix(in srgb, var(--yellow) var(--ink-mix), var(--text));
    font-size: 13px;
    font-weight: 700;
  }
  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--yellow);
  }
  .status-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--yellow);
    animation: ping 2.2s var(--ease) infinite;
  }
  @keyframes ping {
    70%,
    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }
  .volunteer-lead {
    margin-top: 20px;
    font-size: clamp(18px, 1.7vw, 21px);
    font-weight: 600;
    line-height: 1.5;
  }
  .volunteer-text {
    margin-top: 12px;
    color: var(--text-2);
    line-height: 1.7;
  }
  .volunteer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: auto;
    padding-top: 32px;
  }
  .text-link {
    color: var(--text-2);
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 5px;
    transition: color 0.2s;
  }
  .text-link:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }

  /* Resources */
  .resources-text {
    margin-top: 12px;
    color: var(--text-2);
  }
  .resource-list {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }
  .resource-list li {
    border-bottom: 1px solid var(--line);
  }
  .resource-list a {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 20px;
    gap: 14px;
    align-items: center;
    padding: 16px 8px;
    border-radius: 12px;
    transition: background-color 0.2s;
  }
  .resource-list a:hover {
    background: var(--tint-2);
  }
  .resource-number {
    color: var(--text-3);
    font-size: 13px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .resource-copy {
    display: grid;
    gap: 2px;
  }
  .resource-type {
    color: var(--text-3);
    font-size: 12px;
    font-weight: 600;
  }
  .resource-copy strong {
    font-size: 17px;
    font-weight: 700;
  }
  .resource-desc {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }
  .resource-arrow {
    width: 18px;
    height: 18px;
    color: var(--text-3);
    transition:
      transform 0.25s var(--ease),
      color 0.2s;
  }
  .resource-list a:hover .resource-arrow {
    color: var(--text);
    transform: translate(2px, -2px);
  }

  @media (max-width: 1000px) {
    .involved-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot::after {
      animation: none;
    }
  }
</style>
