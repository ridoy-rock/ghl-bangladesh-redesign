---
// Home v3 (draft): a dark, feed-style homepage. It has its own header, footer
// and global tokens so the live pages and their stylesheet stay untouched.
import Footer from "../components/community/v3/Footer.astro";
import Pill from "../components/community/v3/Pill.astro";
import { groupUrl } from "../data/community";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "HighLevel Bangladesh | Community, Meetups & Workshops",
  description = "Connect with the HighLevel community in Bangladesh. Learn through meetups and workshops with chapter leader Mehedi Sharif.",
} = Astro.props;
// On the v3 homepage the sections are anchors; the other v3 pages link back to them.
const path = Astro.url.pathname.replace(/\/+$/, "");
const home = path === "/v3";
const section = (id: string) => (home ? `#${id}` : `/v3#${id}`);
const nav = [
  ["Community", section("community")],
  ["Events", section("events")],
  ["Photos", section("gallery")],
  ["Our story", section("our-story")],
  ["Resources", "/v3/resources"],
  ["Volunteer", "/v3/volunteers"],
];
const current = (href: string) => (href === path ? "page" : undefined);
const canonical = new URL(Astro.url.pathname, "https://ghlbangladesh.com");
const socialImage =
  "https://ghlbangladesh.com/images/community/ghl-bangladesh-og.jpg";
const socialImageAlt = "GHL Bangladesh — HighLevel community in Bangladesh";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="robots" content="noindex" /><meta
      name="theme-color"
      content="#030e18"
    /><meta name="color-scheme" content="dark light" /><title>
      {title}
    </title><meta name="description" content={description} /><link
      rel="canonical"
      href={canonical}
    /><link
      rel="icon"
      href="/favicon-32x32.png"
      type="image/png"
      sizes="32x32"
    /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
      sizes="180x180"
    /><meta property="og:type" content="website" /><meta
      property="og:locale"
      content="en_BD"
    /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:image"
      content={socialImage}
    /><meta property="og:image:width" content="1200" /><meta
      property="og:image:height"
      content="630"
    /><meta property="og:image:type" content="image/jpeg" /><meta
      property="og:image:alt"
      content={socialImageAlt}
    /><meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:image"
      content={socialImage}
    /><meta name="twitter:image:alt" content={socialImageAlt} /><link
      rel="preload"
      href="/images/community/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    /><script is:inline>
      // lets the stylesheet hide reveal-on-scroll content only when scripts run
      document.documentElement.classList.add("js");
      // Theme before first paint: the visitor's saved choice, else the device setting.
      (function () {
        var theme;
        try {
          theme = localStorage.getItem("ghl-v3-theme");
        } catch (e) {}
        if (theme !== "light" && theme !== "dark")
          theme = matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta)
          meta.setAttribute(
            "content",
            theme === "light" ? "#f5f6f1" : "#030e18",
          );
      })();
    </script></head
  ><body class="v3">
    <a class="v3-skip" href="#main">Skip to content</a>
    <header class="v3-header">
      <div class="v3-wrap v3-header-inner">
        <a
          class="v3-brand"
          href={home ? "#main" : "/v3"}
          aria-label={home
            ? "GHL Bangladesh, back to top"
            : "GHL Bangladesh home"}
          ><img
            class="logo-on-dark"
            src="/images/community/chapter-logo.svg"
            width="1430"
            height="266"
            alt="GHL Bangladesh"
            loading="eager"
          /><img
            class="logo-on-light"
            src="/images/community/chapter-logo-dark.svg"
            width="1430"
            height="266"
            alt="GHL Bangladesh"
            loading="lazy"
          /></a
        >
        <nav class="v3-nav" aria-label="Main navigation">
          {
            nav.map(([label, href]) => (
              <a href={href} aria-current={current(href)}>
                {label}
              </a>
            ))
          }
        </nav>
        <button
          class="v3-theme"
          type="button"
          aria-label="Switch to light theme"
          ><svg
            class="i-sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="4.2"></circle><path
              d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"
            ></path></svg
          ><svg
            class="i-moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"
            ></path></svg
          ></button
        >
        <Pill
          class="v3-header-join"
          size="sm"
          label="Join the community"
          href={groupUrl}
        />
        <button
          class="v3-menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="v3-mobile-nav"
          aria-label="Open navigation"><span></span><span></span></button
        >
      </div>
      <nav
        id="v3-mobile-nav"
        class="v3-mobile-nav"
        aria-label="Mobile navigation"
        hidden
      >
        <ol>
          {
            nav.map(([label, href], index) => (
              <li>
                <a href={href} aria-current={current(href)}>
                  <span class="v3-mobile-index" aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  {label}
                </a>
              </li>
            ))
          }
        </ol>
        <Pill
          class="v3-mobile-join"
          size="lg"
          label="Join the community"
          href={groupUrl}
        />
      </nav>
    </header>
    <main id="main"><slot /></main>
    <Footer />
    <script>
      const header = document.querySelector<HTMLElement>(".v3-header");
      const toggle =
        document.querySelector<HTMLButtonElement>(".v3-menu-toggle");
      const menu = document.querySelector<HTMLElement>("#v3-mobile-nav");

      // Light / dark switch. The choice is remembered on this device.
      const root = document.documentElement;
      const themeButton =
        document.querySelector<HTMLButtonElement>(".v3-theme");
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      const labelTheme = () => {
        const light = root.dataset.theme === "light";
        themeButton?.setAttribute(
          "aria-label",
          light ? "Switch to dark theme" : "Switch to light theme",
        );
      };
      themeButton?.addEventListener("click", () => {
        const next = root.dataset.theme === "light" ? "dark" : "light";
        // a short cross-fade, skipped for reduced motion
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.add("theme-fade");
          window.setTimeout(() => root.classList.remove("theme-fade"), 400);
        }
        root.dataset.theme = next;
        themeMeta?.setAttribute(
          "content",
          next === "light" ? "#f5f6f1" : "#030e18",
        );
        try {
          localStorage.setItem("ghl-v3-theme", next);
        } catch {}
        labelTheme();
      });
      labelTheme();

      // Header gets a hairline and a frosted background once the page moves.
      const paint = () =>
        header?.classList.toggle("scrolled", window.scrollY > 8);
      window.addEventListener("scroll", paint, { passive: true });
      paint();

      // Full-screen mobile menu
      const setMenu = (open: boolean) => {
        if (!toggle || !menu) return;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute(
          "aria-label",
          open ? "Close navigation" : "Open navigation",
        );
        menu.hidden = !open;
        document.body.style.overflow = open ? "hidden" : "";
        header?.classList.toggle("menu-open", open);
      };
      toggle?.addEventListener("click", () =>
        setMenu(toggle.getAttribute("aria-expanded") !== "true"),
      );
      menu
        ?.querySelectorAll("a")
        .forEach((a) => a.addEventListener("click", () => setMenu(false)));
      document.addEventListener("keydown", (event) => {
        if (
          event.key === "Escape" &&
          toggle?.getAttribute("aria-expanded") === "true"
        ) {
          setMenu(false);
          toggle.focus();
        }
      });
      matchMedia("(min-width: 1121px)").addEventListener("change", (event) => {
        if (event.matches) setMenu(false);
      });

      // Scroll reveal: elements with "v3-reveal" fade up once they enter the screen.
      const targets = document.querySelectorAll(".v3-reveal");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                observer.unobserve(entry.target);
              }
            }),
          { rootMargin: "0px 0px -6% 0px", threshold: 0.06 },
        );
        targets.forEach((el) => observer.observe(el));
      } else targets.forEach((el) => el.classList.add("in"));
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Plus Jakarta Sans";
    src: url("/images/community/plus-jakarta-sans-latin-ext.woff2")
      format("woff2");
    font-weight: 200 800;
    font-display: swap;
    unicode-range:
      U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304,
      U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020,
      U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "Plus Jakarta Sans";
    src: url("/images/community/plus-jakarta-sans-latin.woff2") format("woff2");
    font-weight: 200 800;
    font-display: swap;
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
      U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Home v3 tokens: a navy-black base, the brand navy as the raised surface,
     the three logo arrow colours and the Bangladesh flag as accents. */
  .v3,
  .v3-dark {
    --bg: #030e18;
    --surface: #061d30;
    --surface-2: #0a2740;
    --surface-3: #0f3352;
    --line: rgba(196, 226, 255, 0.09);
    --line-2: rgba(196, 226, 255, 0.18);
    --text: #f1f5f8;
    --text-2: #a9b9c7;
    --text-3: #71859a;
    --line-3: rgba(196, 226, 255, 0.32);
    --tint-1: rgba(255, 255, 255, 0.03);
    --tint-2: rgba(255, 255, 255, 0.05);
    --tint-3: rgba(255, 255, 255, 0.09);
    --dot: rgba(196, 226, 255, 0.08);
    --strip-bg: rgba(6, 29, 48, 0.45);
    --glass-card: rgba(6, 29, 48, 0.9);
    --header-bg: rgba(3, 14, 24, 0.82);
    --shadow: rgba(0, 0, 0, 0.85);
    --solid-hover: #ffffff;
    --solid-glow: rgba(255, 255, 255, 0.45);
    /* how much of an accent colour is kept when it is used as text */
    --ink-mix: 100%;
    color: var(--text);
    --yellow: #f8d325;
    --blue: #20a9ed;
    --green: #0bce55;
    --bd-green: #006a4e;
    --bd-red: #f42a41;
    --radius: 24px;
    --radius-sm: 14px;
    --font:
      "Plus Jakarta Sans", ui-sans-serif, system-ui, -apple-system, "Segoe UI",
      sans-serif;
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    --header: 68px;
  }
  /* Light theme: the warm paper of Home v1, white cards and navy text */
  :root[data-theme="light"] .v3 {
    --bg: #f5f6f1;
    --surface: #ffffff;
    --surface-2: #eef1ec;
    --surface-3: #e2e8e3;
    --line: rgba(6, 29, 48, 0.1);
    --line-2: rgba(6, 29, 48, 0.17);
    --line-3: rgba(6, 29, 48, 0.3);
    --text: #061d30;
    --text-2: #3e5162;
    --text-3: #6d7f8c;
    --tint-1: rgba(6, 29, 48, 0.025);
    --tint-2: rgba(6, 29, 48, 0.045);
    --tint-3: rgba(6, 29, 48, 0.08);
    --dot: rgba(6, 29, 48, 0.09);
    --strip-bg: rgba(6, 29, 48, 0.035);
    --glass-card: rgba(255, 255, 255, 0.92);
    --header-bg: rgba(245, 246, 241, 0.85);
    --shadow: rgba(6, 29, 48, 0.22);
    --solid-hover: #0a2740;
    --solid-glow: rgba(6, 29, 48, 0.35);
    --ink-mix: 55%;
  }
  .v3 .logo-on-light {
    display: none;
  }
  :root[data-theme="light"] .v3 .logo-on-light {
    display: block;
  }
  :root[data-theme="light"] .v3 .logo-on-dark {
    display: none;
  }
  html:has(> body.v3) {
    color-scheme: dark;
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--header, 68px) + 16px);
    background: #030e18;
  }
  html[data-theme="light"]:has(> body.v3) {
    color-scheme: light;
    background: #f5f6f1;
  }
  html.theme-fade .v3,
  html.theme-fade .v3 * {
    transition:
      background-color 0.35s,
      color 0.35s,
      border-color 0.35s,
      fill 0.35s !important;
  }
  @media (prefers-reduced-motion: reduce) {
    html:has(> body.v3) {
      scroll-behavior: auto;
    }
  }
  .v3,
  .v3 *,
  .v3 *::before,
  .v3 *::after {
    box-sizing: border-box;
  }
  .v3 {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: clip;
  }
  .v3 :where(h1, h2, h3, h4, p, figure, ul, ol, blockquote) {
    margin: 0;
  }
  .v3 :where(ul, ol) {
    padding: 0;
    list-style: none;
  }
  .v3 :where(img, video, svg) {
    display: block;
    max-width: 100%;
  }
  .v3 :where(a) {
    color: inherit;
    text-decoration: none;
  }
  .v3 :where(button) {
    font: inherit;
    color: inherit;
  }
  .v3 :focus-visible {
    outline: 2px solid var(--yellow);
    outline-offset: 3px;
    border-radius: 6px;
  }
  .v3 ::selection {
    background: rgba(32, 169, 237, 0.35);
  }

  .v3-wrap {
    width: min(1240px, 100% - 32px);
    margin-inline: auto;
  }
  @media (min-width: 761px) {
    .v3-wrap {
      width: min(1240px, 100% - 64px);
    }
  }
  .v3-section {
    padding-block: clamp(72px, 10vw, 136px);
  }

  /* Section heads: small label, then a headline whose first sentence is bold
     and whose continuation is lighter, so each heading reads like a statement. */
  .v3-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: var(--text-2);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .v3-kicker::before {
    content: "";
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--k, var(--green));
  }
  .v3-h2 {
    max-width: 18ch;
    font-size: clamp(32px, 4.6vw, 56px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .v3-h2 .soft {
    color: var(--text-3);
    font-weight: 700;
  }
  .v3-lead {
    max-width: 58ch;
    margin-top: 20px;
    color: var(--text-2);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.7;
  }

  /* Tag chips, as used on feed cards */
  .v3-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .v3-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 26px;
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--tint-1);
    color: var(--text-2);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Round Bangladesh flag */
  .v3-flag {
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 45% 50%,
        var(--bd-red) 0 34%,
        transparent calc(34% + 0.5px)
      ),
      var(--bd-green);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.08);
  }

  /* Scroll reveal (only hides content when scripts run) */
  .js .v3-reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  .js .v3-reveal.in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .v3-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Skip link */
  .v3-skip {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    transform: translateY(-160%);
    transition: transform 0.2s;
  }
  .v3-skip:focus {
    transform: none;
  }

  /* Header */
  .v3-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }
  .v3-header.scrolled,
  .v3-header.menu-open {
    border-bottom-color: var(--line);
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
  }
  /* a backdrop filter would trap the fixed full-screen menu inside the header */
  .v3-header.menu-open {
    background: var(--bg);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .v3-header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header);
  }
  .v3-brand img {
    width: auto;
    height: 30px;
  }
  .v3-nav {
    display: flex;
    gap: 2px;
    margin-left: auto;
  }
  .v3-nav a {
    padding: 8px 14px;
    border-radius: 10px;
    color: var(--text-2);
    font-size: 14px;
    font-weight: 600;
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .v3-nav a[aria-current="page"] {
    color: var(--text);
    background: var(--tint-2);
  }
  .v3-nav a:hover {
    color: var(--text);
    background: var(--tint-2);
  }
  .v3-theme {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--tint-1);
    color: var(--text-2);
    cursor: pointer;
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }
  .v3-theme:hover {
    border-color: var(--line-3);
    background: var(--tint-2);
    color: var(--text);
  }
  .v3-theme svg {
    width: 18px;
    height: 18px;
    transition: transform 0.5s var(--ease);
  }
  .v3-theme:hover svg {
    transform: rotate(20deg);
  }
  /* show the theme you switch to: a sun in dark mode, a moon in light mode */
  .v3-theme .i-moon,
  :root[data-theme="light"] .v3-theme .i-sun {
    display: none;
  }
  :root[data-theme="light"] .v3-theme .i-moon {
    display: block;
  }
  .v3-menu-toggle {
    display: none;
  }
  .v3-mobile-nav {
    display: none;
  }
  @media (max-width: 1120px) {
    .v3-nav,
    .v3-header-join {
      display: none !important;
    }
    .v3-theme {
      width: 44px;
      height: 44px;
      margin-left: auto;
    }
    .v3-menu-toggle {
      display: grid;
      place-content: center;
      gap: 6px;
      width: 44px;
      height: 44px;
      margin-left: -14px;
      padding: 0;
      border: 1px solid var(--line-2);
      border-radius: 12px;
      background: var(--tint-2);
      cursor: pointer;
    }
    .v3-menu-toggle span {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: var(--text);
      transition: transform 0.3s var(--ease);
    }
    .v3-menu-toggle[aria-expanded="true"] span:first-child {
      transform: translateY(4px) rotate(45deg);
    }
    .v3-menu-toggle[aria-expanded="true"] span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }
    .v3-mobile-nav:not([hidden]) {
      position: fixed;
      inset: var(--header) 0 0;
      display: flex;
      flex-direction: column;
      gap: 32px;
      padding: 24px 16px max(32px, env(safe-area-inset-bottom));
      overflow-y: auto;
