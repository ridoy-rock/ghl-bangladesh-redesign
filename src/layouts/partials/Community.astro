---
import { highlight, markdownify } from "@/lib/utils/textConverter";

const { community } = Astro.props;
---

<section class="section" id="community" aria-labelledby="community-heading">
  <div class="container">
    <div
      class="grid grid-cols-1 items-start gap-[clamp(32px,6vw,96px)] min-[961px]:grid-cols-[1.15fr_1fr] min-[961px]:items-end"
    >
      <div class="reveal">
        <span class="kicker">{community.kicker}</span>
        <h2
          id="community-heading"
          class="[&_em]:text-accent dark:[&_em]:text-darkmode-accent mt-4.5 text-[length:clamp(38px,5vw,72px)] leading-[1.04] [&_em]:not-italic"
          set:html={highlight(community.title)}
        />
      </div>
      <div class="reveal">
        <p
          class="font-secondary text-text-dark dark:text-darkmode-text-dark mb-3.5 text-[length:clamp(19px,1.7vw,23px)] leading-[1.4] font-semibold"
          set:html={markdownify(community.lead)}
        />
        <p
          class="text-text dark:text-darkmode-text"
          set:html={markdownify(community.content)}
        />
      </div>
    </div>

    <!-- Learn → connect → grow: each benefit stands on a taller arrow than the one before.
         Arrow sizes, colours and the phone layout are in src/styles/components.css. -->
    <div
      class="benefits reveal border-text-dark/22 dark:border-darkmode-text-dark/22 relative mt-[clamp(64px,8vw,120px)] grid grid-cols-1 items-end gap-0 border-l min-[761px]:grid-cols-3 min-[761px]:gap-[clamp(20px,4vw,64px)] min-[761px]:border-b min-[761px]:border-l-0"
    >
      {
        community.benefits.map(
          (benefit: { label: string; title: string; content: string }) => (
            <article class="benefit grid grid-cols-[auto_1fr] grid-rows-[auto_auto_auto] items-start gap-x-5 py-5.5 min-[761px]:flex min-[761px]:flex-col min-[761px]:py-0">
              <span class="col-start-2 mb-3 block text-[13px] font-semibold tracking-[0.12em] [color:var(--accent-ink)] uppercase">
                {benefit.label}
              </span>
              <h3
                class="col-start-2 mb-3 text-[length:clamp(22px,2.2vw,32px)] leading-[1.1]"
                set:html={markdownify(benefit.title)}
              />
              <p
                class="text-text dark:text-darkmode-text col-start-2 max-w-[330px] text-[15.5px]"
                set:html={markdownify(benefit.content)}
              />
              <span class="benefit-arrow" aria-hidden="true" />
            </article>
          ),
        )
      }
    </div>
  </div>
</section>
