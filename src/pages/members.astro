---
import Layout from "../layouts/CommunityLayout.astro";
import MemberCard from "../components/community/MemberCard.astro";
import Join from "../components/community/Join.astro";
import { groupUrl, members, sampleMembers } from "../data/community";

const people = [...members, ...sampleMembers];
const accents = ["green", "blue", "yellow"] as const;
const span4 = 4 - (people.length % 4);
const span3 = 3 - (people.length % 3);
const span2 = 2 - (people.length % 2);
---

<Layout
  title="Members — GHL Bangladesh"
  description="Meet the people of GHL Bangladesh. Get to know the chapter leader and meetup co-organiser behind our local HighLevel community."
>
  <section class="members-intro" aria-labelledby="members-title">
    <div class="wrap members-intro-inner">
      <div class="members-intro-copy">
        <h1 id="members-title">Meet the <span>members.</span></h1>
        <p>Get to know the people of HighLevel Bangladesh.</p>
      </div>
    </div>
  </section>

  <section class="members-directory" aria-labelledby="members-heading">
    <div class="wrap">
      <div class="members-heading">
        <h2 id="members-heading">Faces to names.</h2>
      </div>
      <ul class="members-grid" role="list">
        {
          people.map((member, index) => (
            <li>
              <MemberCard
                member={member}
                accent={accents[index % accents.length]}
              />
            </li>
          ))
        }
        <li
          class="member-invite-item"
          style={`--span-4: ${span4}; --span-3: ${span3}; --span-2: ${span2}`}
        >
          <article
            class="member-invite"
            aria-labelledby="member-invite-heading"
          >
            <div class="member-invite-portrait" aria-hidden="true">
              <svg viewBox="0 0 200 250" fill="none">
                <circle cx="100" cy="80" r="35"></circle>
                <path d="M26 250v-30c0-44 33-76 74-76s74 32 74 76v30"></path>
              </svg>
              <span>You’re welcome here</span>
            </div>
            <div class="member-invite-body">
              <h3 id="member-invite-heading">Pull up a chair.</h3>
              <p>
                Work with HighLevel in Bangladesh? Join the conversations, ask
                questions, and share what you’re learning.
              </p>
              <a
                href={groupUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Find us on Facebook (opens in a new tab)"
                >Find us on Facebook</a
              >
            </div>
          </article>
        </li>
      </ul>
    </div>
  </section>
  <Join />
</Layout>

<style>
  .members-intro {
    padding-block: clamp(52px, 7vw, 96px);
  }
  .members-intro-inner {
    text-align: center;
  }
  .members-intro-copy {
    max-width: 850px;
    margin-inline: auto;
  }
  .members-intro h1 {
    font-size: clamp(2.75rem, 5.3vw, 4.75rem);
    line-height: 1.08;
  }
  .members-intro h1 span {
    color: var(--forest);
  }
  .members-intro-copy > p {
    max-width: 620px;
    margin: 24px auto 0;
    color: var(--ink-2);
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.7;
  }
  .members-directory {
    padding-block: clamp(56px, 7vw, 88px) clamp(64px, 8vw, 104px);
    /* same colour as #f5f6f1 in light mode; follows the dark theme */
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
  .members-heading h2 {
    font-size: clamp(2rem, 3.6vw, 3.25rem);
  }
  .members-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .members-grid > li {
    min-width: 0;
  }
  .member-invite-item {
    grid-column: span var(--span-4);
    container-type: inline-size;
  }
  .member-invite {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 8px;
    border: 1px dashed #9caaa0;
    border-radius: calc(var(--radius) + 8px);
  }
  .member-invite-portrait {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--paper-2);
  }
  .member-invite-portrait svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: #718574;
    stroke-width: 1.5;
    stroke-dasharray: 5 6;
  }
  .member-invite-portrait span {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 7px 13px;
    border-radius: 999px;
    background: var(--card);
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .member-invite-body {
    padding: 24px 18px 18px;
  }
  .member-invite-body h3 {
    font-size: clamp(1.4rem, 2.1vw, 1.875rem);
    line-height: 1.2;
  }
  .member-invite-body p {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.7;
  }
  .member-invite-body a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 20px;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .member-invite-body a:hover {
    color: var(--forest);
  }
  .member-invite-body a:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 4px;
    border-radius: 3px;
  }
  @container (min-width: 560px) {
    .member-invite {
      flex-direction: row;
      align-items: center;
    }
    .member-invite-portrait {
      flex: 0 0 38%;
    }
    .member-invite-body {
      padding: 28px;
    }
  }
  @media (max-width: 1179px) {
    .members-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .member-invite-item {
      grid-column: span var(--span-3);
    }
  }
  @media (max-width: 999px) {
    .members-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .member-invite-item {
      grid-column: span var(--span-2);
    }
  }
  @media (max-width: 760px) {
    .members-intro-copy > p {
      margin-top: 20px;
    }
    .members-grid {
      margin-top: 30px;
    }
  }
  @media (max-width: 599px) {
    .members-grid {
      gap: 12px;
    }
    .member-invite {
      flex-direction: column;
      align-items: stretch;
    }
    .member-invite-portrait {
      flex-basis: auto;
      aspect-ratio: 4 / 3;
    }
    .member-invite-body {
      padding: 24px 18px 18px;
    }
  }
</style>
